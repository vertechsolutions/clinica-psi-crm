# ── IA (Google Gemini) ─────────────────────────────────────────────
# A assistente usa a API do Google Gemini. Key grátis no Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional — modelo (default gemini-2.5-flash, do free tier).
# GEMINI_MODEL=gemini-2.5-flash

# ── Banco (Postgres do Railway) ────────────────────────────────────
# No Railway, provisione o plugin Postgres e referencie:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Em produção use a URL interna (*.railway.internal): sem SSL, sem egress.
# Sem DATABASE_URL o app sobe, mas o webhook do WhatsApp fica inativo.
DATABASE_URL=

# ── Transporte do WhatsApp ─────────────────────────────────────────
# zapi (default) = Z-API, número pareado por QR code (o WhatsApp continua no
# celular da Bruna). meta = WhatsApp Cloud API. Trocar aqui é o rollback.
WA_PROVIDER=zapi

# ── Z-API (WA_PROVIDER=zapi) ───────────────────────────────────────
# Painel da instância: https://app.z-api.io — Instância > Editar.
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
# Token de segurança da CONTA (Segurança > Client-Token). Sem ele a Z-API recusa
# as chamadas de envio quando a trava está ligada.
ZAPI_CLIENT_TOKEN=
# Segredo NOSSO, inventado aqui: a Z-API não assina o webhook, então a porta é
# este valor. Cole a URL no painel COM ele na query:
#   https://<app>.up.railway.app/api/whatsapp/webhook?s=<ZAPI_WEBHOOK_SECRET>
# Sem esta variável o webhook recusa tudo (fail-closed).
ZAPI_WEBHOOK_SECRET=

# ── WhatsApp Cloud API (Meta) — só com WA_PROVIDER=meta ─────────────
# Token permanente (System User) do app da Meta. NUNCA commitar.
WHATSAPP_TOKEN=
# Phone Number ID do número da clínica — pegue no WhatsApp Manager (muda quando o
# número muda; não é o telefone, é o ID numérico ao lado dele).
WHATSAPP_PHONE_NUMBER_ID=
# Token que VOCÊ inventa e cola no campo "Verify token" do webhook no App Dashboard.
WHATSAPP_VERIFY_TOKEN=
# App Secret do app Meta (App Dashboard > Settings > Basic). Valida a assinatura do webhook.
WHATSAPP_APP_SECRET=
# Opcional — versão da Graph API (default v25.0).
# WHATSAPP_GRAPH_VERSION=v25.0

# ── Admin (tela de calibração + exclusão de dados) ─────────────────
# Chave pra editar o raciocínio ativo (/api/config) e apagar dados de paciente
# (/api/admin/patient). Invente uma senha forte. Sem ela, em produção esses
# endpoints recusam acesso. A tela pede essa chave no campo "chave de admin".
ADMIN_API_KEY=

# ── Railway (deploy) ───────────────────────────────────────────────
# Fixa o Node do build (Next 16 exige >=20.9). Setar como env var no Railway:
# RAILPACK_NODE_VERSION=22

# ── Formulário + handoff (goals 4, 8) ──────────────────────────────
# Link do Google Forms de triagem. Sem ele, {FORM_URL} vaza como placeholder.
FORM_URL=
# Dados do Pix que a Camila envia na hora do pagamento (texto livre: chave + titular).
# Sem ele, a Camila diz que vai encaminhar e a equipe manda manualmente.
# Ex.: PIX_INFO=Chave Pix (CNPJ): 53480459000104 — em nome de Cazule Psicologia
PIX_INFO=
# Opcional — SÓ a chave Pix, usada na validação automática do comprovante (o
# destinatário lido no comprovante é comparado com ela). Sem ela, a chave é
# derivada do texto da PIX_INFO (funciona quando a chave está escrita nele).
# Setando esta, mantenha o NOME da clínica na PIX_INFO: o validador usa o titular
# pra não acusar o paciente quando o banco mascara a chave no comprovante.
# PIX_CHAVE=53480459000104
# Números que recebem o alerta quando o form é enviado (E.164 sem "+", vírgula).
NOTIFY_ALERT_NUMBERS=5527981178233,5549999551051
# Trava de estreia: com a lista preenchida, a Camila SÓ responde estes números
# (os outros são ignorados sem gravar nada). Serve pra rodar no WhatsApp real da
# clínica sem a IA abordar conversa pessoal ou paciente já em atendimento.
# Vazio/ausente = atende todo mundo. E.164 sem "+", separado por vírgula.
WA_ALLOWLIST=
# Opcional — modelo dedicado pra transcrição de áudio (default cai no GEMINI_MODEL).
# ⚠️ NÃO use gemini-2.5-flash-lite: descontinuado p/ contas novas (404 em produção,
# 17/07/2026). Só sete se validar antes com: npx tsx scripts/test-transcribe-live.ts
# GEMINI_TRANSCRIBE_MODEL=

# ── Agenda no Google Sheets (goals 2, 5) ───────────────────────────
# JSON da Service Account (uma linha). Sem isto, a Camila não lê a agenda (fallback).
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID da planilha "Cazule — Agenda" (da URL /spreadsheets/d/<ID>/edit).
AGENDA_SHEET_ID=

# ── Follow-up proativo (goal 3 — ADIADO, opt-in) ───────────────────
# Reengaja leads frios (24h+ sem retorno). Default: false (DESLIGADO).
# Ligar SOMENTE com "true" explícito e APÓS:
#   (a) o template Meta "retomada_atendimento" estar APROVADO;
#   (b) a Bruna validar a cadência e existir opt-out.
# NUNCA ligar sem essas validações (risco de spam / ban da Meta).
FOLLOWUP_ENABLED=false
# Nome do template aprovado na Meta p/ reengajar fora da janela de 24h.
FOLLOWUP_TEMPLATE_NAME=
